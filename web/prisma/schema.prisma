generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        Int       @id @default(autoincrement())
  username                  String    @unique
  hashedPassword            String?
  email                     String?   @unique
  emailVerifiedAt           DateTime?
  displayName               String?
  avatarUrl                 String?
  registrationCountryCode   String?
  registrationCountry       String?
  registrationRegion        String?
  registrationCity          String?
  registrationGeoSource     String?
  registrationGeoCapturedAt DateTime?
  role                      String    @default("user") // user | moderator | admin
  balance                   Int       @default(200)
  isVip                     Boolean   @default(false)
  vipExpiresAt              DateTime?
  vipTierId                 Int?
  playthingAccess           Boolean   @default(false) // 玩物专区单独授权
  disabledAt                DateTime? // 封禁时间；非空表示禁止登录且会话失效
  acceptedTermsAt           DateTime?
  termsVersion              String?
  birthDate                 DateTime?
  ageVerifiedAt             DateTime?
  adultModeEnabled          Boolean   @default(false)
  /// AI 文本动作攒下的零头，千分之一点。满 1000 才动 balance，见 llm/billing.ts。
  /// 永不归零：跨充值继续累计，否则每次充值都等于抹掉一笔已经发生的成本。
  aiDebtMicro               Int       @default(0)
  /// 草稿自动保存（VIP 功能）。关闭时草稿只在用户按保存时才写进数据库，
  /// 本地 IndexedDB 缓存照旧工作。
  draftAutoSave             Boolean   @default(false)
  createdAt                 DateTime  @default(now())

  generations             Generation[]
  transactions            Transaction[]
  nowPayments             NowPayment[]
  featuredWorks           PublicWork[]
  vipTier                 VipTier?                 @relation(fields: [vipTierId], references: [id], onDelete: SetNull)
  playthingGenerations    PlaythingGeneration[]
  mediaAssets             MediaAsset[]
  oauthAccounts           OAuthAccount[]
  emailVerificationTokens EmailVerificationToken[]
  drafts                  Draft[]
  promptTemplates         PromptTemplate[]

  @@index([registrationCountryCode, createdAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model OAuthAccount {
  id                Int      @id @default(autoincrement())
  userId            Int
  provider          String
  providerAccountId String
  providerEmail     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model EmailVerificationToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/**
 * NOWPayments 托管发票与 IPN 入账记录
 */
model NowPayment {
  id                   Int      @id @default(autoincrement())
  userId               Int
  orderId              String   @unique
  invoiceId            String?
  paymentId            String?
  credits              Int
  amountUsdCents       Int
  status               String   @default("waiting")
  payCurrency          String?
  actuallyPaid         String?
  network              String?
  txHash               String?
  credited             Boolean  @default(false)
  nowPaymentsAccountId Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id])
  nowPaymentsAccount NowPaymentsAccount? @relation(fields: [nowPaymentsAccountId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([paymentId])
  @@index([nowPaymentsAccountId, createdAt])
}

/**
 * NOWPayments 收款配置：API Key 与 IPN Secret 加密保存；无激活配置时才回退 env
 */
model NowPaymentsAccount {
  id           Int      @id @default(autoincrement())
  label        String
  apiKeyEnc    String
  ipnSecretEnc String
  baseUrl      String   @default("https://api.nowpayments.io/v1")
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments NowPayment[]

  @@index([isActive, createdAt])
}

model Generation {
  id                 Int       @id @default(autoincrement())
  userId             Int
  mode               String // txt2img | img2img | imgedit | txt2vid | img2vid
  tier               String    @default("low") // low | mid | high
  spicy              Boolean   @default(false) // Spicy 档（会员专属）
  productId          Int? // 下单时命中的 GenerationProduct（软引用，产品可重建）
  prompt             String
  negativePrompt     String?
  params             String
  provider           String    @default("wavespeed") // 下单时命中的档位所属渠道
  providerJobId      String?   @map("zenJobId") // 上游任务 ID（prediction id）
  wsAccountId        Int? // 创建该任务时使用的 ProviderAccount
  status             String    @default("pending") // pending|queued|processing|succeeded|partial|failed
  progress           Int       @default(0) // 0-100，来自上游轮询
  providerError      String?   @map("zenError") // 上游返回的失败原因
  resultUrls         String?
  cost               Int // 本站用户扣点
  providerCostUsd    Float? // 上游实际计费（美元），估价失败时为空
  deletedAt          DateTime?
  visibility         String    @default("private") // private | featured | hidden
  isAdult            Boolean   @default(false)
  safetyCategories   String    @default("[]")
  ownerVipAtCreation Boolean   @default(false)
  retentionAssigned  Boolean   @default(false)
  mediaExpiresAt     DateTime?
  mediaDeletedAt     DateTime?
  /// 分享页令牌。生成记录默认私有，公开链接必须不可枚举——用 id 会让任何人
  /// 遍历出别人的作品。为空表示从未分享过；撤销分享就置回 null。
  shareToken         String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  user      User             @relation(fields: [userId], references: [id])
  wsAccount ProviderAccount? @relation(fields: [wsAccountId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([deletedAt, status, createdAt])
  @@index([providerJobId])
  @@index([wsAccountId, createdAt])
  @@index([mediaExpiresAt, mediaDeletedAt])
}

model PublicWork {
  id                 Int      @id @default(autoincrement())
  title              String?
  mode               String
  prompt             String
  negativePrompt     String?
  params             String   @default("{}")
  mediaUrl           String
  thumbUrl           String?
  source             String // user_feature | provider_import
  sourceGenerationId Int?
  sourceJobId        String?  @map("sourceZenJobId")
  sortOrder          Int      @default(0)
  isPublished        Boolean  @default(true)
  isAdult            Boolean  @default(false)
  featuredById       Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  featuredBy User? @relation(fields: [featuredById], references: [id])

  @@index([isPublished, isAdult, sortOrder, createdAt])
}

/**
 * 自动清理策略：按媒体类型、生成渠道和创建时会员状态区分
 */
/**
 * 模型能力档案：把上游 schema 归一成站内固定的输入角色与产出类型。
 * 按 (provider, modelId) 建键而不是只按 modelId —— 同一个 model id 在两家的能力
 * 可能不同（实测：seedance-2.5/text-to-video 在 WaveSpeed 收 reference_*，
 * 在 Atlas 是纯文生视频）。
 * 派生逻辑见 lib/model-capability.ts。
 */
model ModelCapability {
  id       Int    @id @default(autoincrement())
  provider String
  modelId  String

  /// 归一化输入位，CapabilityInput[] 的 JSON
  inputs  String @default("[]")
  /// 产出声明，CapabilityOutput[] 的 JSON
  outputs String @default("[]")
  /// 派生依据，人工复核时用来理解「为什么这么判」
  notes   String @default("[]")

  /// derived = 自动派生；manual = 人工覆盖过，重新派生不覆盖它
  source     String    @default("derived")
  /// 派生时所用 schema 的指纹；变了就重新派生（manual 的只标待复核）
  schemaHash String?
  /// 人工复核通过的时间。为空 = 在待复核队列里
  reviewedAt DateTime?
  /// schema 变过但因为 source=manual 没有自动改，等人来看
  staleSince DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, modelId])
  @@index([source, reviewedAt])
  @@index([staleSince])
}

model MediaCleanupPolicy {
  id            Int      @id @default(autoincrement())
  mediaType     String // upload | generated
  channel       String // all | main | plaything
  audience      String // all | non_vip | vip
  retentionDays Int? // null = 永不过期
  updatedAt     DateTime @updatedAt

  @@unique([mediaType, channel, audience])
}

/**
 * 上传接口产生的一次性输入媒体；生成结果由 Generation 表管理
 */
model MediaAsset {
  id                Int       @id @default(autoincrement())
  userId            Int
  kind              String // upload
  channel           String // wavespeed
  url               String
  objectKey         String?
  contentType       String?
  bytes             Int?
  /// 用户上传时的原始文件名，用于「输入媒体已被删除」提示里指认是哪一个文件
  filename          String?
  /// 删除原因（retention_expired / admin_manual / user_deleted…），同上
  deleteReason      String?
  /// 文件内容的 SHA-256（hex）。相同内容只在 OSS 上存一份，多条记录共用同一个
  /// objectKey；因此删除对象前必须确认没有别的存活记录还指着它（见 media-cleanup）。
  /// 老数据为空，不参与去重。
  sha256            String?
  sourceId          Int?
  retentionAssigned Boolean   @default(false)
  expiresAt         DateTime?
  deletedAt         DateTime?
  deleteAttempts    Int       @default(0)
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt, deletedAt])
  @@index([userId, createdAt])
  @@index([sourceId])
  /// 秒传查找：按内容哈希找还活着的同内容记录
  @@index([sha256, deletedAt])
  /// 引用计数：删对象前数一下还有几条存活记录指着同一个 objectKey
  @@index([objectKey, deletedAt])
}

model MediaCleanupRun {
  id          Int       @id @default(autoincrement())
  dryRun      Boolean   @default(false)
  status      String    @default("running")
  scanned     Int       @default(0)
  deleted     Int       @default(0)
  failed      Int       @default(0)
  detail      String    @default("{}")
  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

/**
 * Stripe 账户配置：Secret Key + Webhook Secret 成对；同一时间最多一个 isActive=true
 */
model StripeAccount {
  id               Int      @id @default(autoincrement())
  label            String // 管理端备注名
  publishableKey   String? // pk_… 可公开，明文存储（选填）
  secretKeyEnc     String // sk_… AES-256-GCM 加密
  webhookSecretEnc String // whsec_… AES-256-GCM 加密
  isActive         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  transactions Transaction[]
}

/**
 * 对象存储账户（S3 兼容 API）；同一时间最多一个 isActive=true
 */
model OssAccount {
  id                 Int      @id @default(autoincrement())
  label              String
  provider           String   @default("s3") // s3 | aliyun | minio | r2
  endpoint           String
  region             String   @default("us-east-1")
  bucket             String
  accessKeyId        String
  secretAccessKeyEnc String
  publicBaseUrl      String?
  pathPrefix         String   @default("media")
  mirrorResults      Boolean  @default(true) @map("mirrorZenResults")
  forcePathStyle     Boolean  @default(false)
  isActive           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/**
 * 文本 LLM 上游账户（OpenRouter 等）；同一时间最多一个 isActive=true
 *
 * 刻意**不复用** `ProviderAccount`：那套是任务制（submit → 轮询）、按次计价、
 * 还要 fetchSchema，这里一个都用不上。硬塞进去会让那套抽象长出一堆
 * 只有一家用得上的可选方法。与 `HfAccount` / `OpenAiAccount` 同构。
 */
model LlmAccount {
  id        Int      @id @default(autoincrement())
  provider  String   @default("openrouter")
  label     String
  apiKeyEnc String // AES-256-GCM
  baseUrl   String? // 空则用 env.OPENROUTER_BASE_URL
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * 文本模型注册表。
 *
 * ⚠️ 与 `GenerationProduct` 的关键差别：这里的 `label` / `providerModelId`
 * **允许下发到前端**。技能系统里「用哪个模型」本来就是用户在选，公开它不损失
 * 任何东西。生成端要藏的是「哪个模型撑起哪个档位」——整套档位定价建立在
 * 那上面。两者不是一回事，日后别看着不一致就顺手改成一样。
 */
model LlmModel {
  id              Int    @id @default(autoincrement())
  /// 稳定标识，技能引用它
  key             String @unique
  label           String
  provider        String @default("openrouter")
  /// 上游真名，服务端用
  providerModelId String
  /// basic | advanced | unrestricted
  tierCode        String

  /// 上游单价，美元 / 百万 token。用于预估与「上游涨价了没」的监控；
  /// 真账以上游返回的实际成本为准，拿不到时才回退到这张表
  inputUsdPerMTok  Float
  outputUsdPerMTok Float
  /// 从上游模型列表同步的时间
  priceSyncedAt    DateTime?

  /// 加价倍率，与生成端同口径：普通 13000、无限制档 15000
  priceMultiplierBps Int     @default(13000)
  contextTokens      Int     @default(8000)
  supportsStreaming  Boolean @default(true)
  /// true 时 requiresAdult 必须也为 true，管理端保存时强制校验
  uncensored         Boolean @default(false)
  requiresVipRank    Int     @default(0)
  requiresAdult      Boolean @default(false)

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tierCode, isActive, sortOrder])
}

/**
 * 每次 LLM 调用的用量与成本。
 *
 * 管理员的成本报表全靠这张表——没有它就不知道 AI 功能到底在亏还是在赚。
 * 单位刻意都用整数：`costUsdMicro` 是百万分之一美元，`chargedMicro`
 * 是千分之一点。浮点数在按行求和时会飘，而这张表存在的意义就是对账。
 */
model LlmUsageLog {
  id               Int    @id @default(autoincrement())
  userId           Int
  /// S0/S1 阶段是硬编码动作名（polish…），S2 起是 Skill.key
  skillKey         String
  modelKey         String
  /// selection | manual | block | slash | empty | submit
  trigger          String
  promptTokens     Int
  completionTokens Int
  /// 上游真实成本，μ$
  costUsdMicro     Int
  /// 成本是估出来的而不是上游给的（规划 8.1 第 3 条要求标出来）
  costEstimated    Boolean @default(false)
  /// 本次应扣，μ点
  chargedMicro     Int
  /// 本次实际落到 balance 上的整点（微点没攒够 1 点时为 0）
  settledCredits   Int
  /// ok | blocked | canceled | failed | timeout
  status           String

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([modelKey, createdAt])
  @@index([status, createdAt])
}

/**
 * Hugging Face Token：魔法指令（Dolphin）；同一时间最多一个 isActive=true
 */
model HfAccount {
  id          Int      @id @default(autoincrement())
  label       String
  apiTokenEnc String // hf_… AES-256-GCM
  baseUrl     String? // 空则用 env.HF_INFERENCE_BASE_URL
  magicModel  String? // 空则用 env.HF_MAGIC_MODEL
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/**
 * OpenAI 账户：内容审查用（moderations 端点免费）；同一时间最多一个 isActive=true
 */
model OpenAiAccount {
  id              Int      @id @default(autoincrement())
  label           String
  apiKeyEnc       String // sk-… AES-256-GCM
  baseUrl         String? // 空则用 env.OPENAI_BASE_URL，可指向兼容代理
  moderationModel String? // 空则用 env.OPENAI_MODERATION_MODEL
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/**
 * 生成产品 SKU：模式 + 档位 + 是否 Spicy → 扣点与桥接模型。
 * providerModelId 只在服务端使用，绝不出现在面向生成端的任何响应里。
 */
model GenerationProduct {
  id                  Int      @id @default(autoincrement())
  mode                String // txt2img | img2img | imgedit | txt2vid | img2vid
  tier                String // low | mid | high（视频只用 low / high）
  spicy               Boolean  @default(false) // Spicy 档：会员专属，走 uncensored 模型
  provider            String   @default("wavespeed") // wavespeed | atlas
  providerModelId     String   @default("") // 该渠道的 model_id；空串表示尚未绑定
  label               String // 面向用户的档位名，不得含模型信息
  description         String   @default("") // 档位说明（分辨率/时长/画质），同样不得含模型名
  creditCost          Int
  /**
   * 计价溯源：ZenCreator 对标工具点数 × 10（细分倍数）× 倍率 = creditCost
   */
  refCredits          Int      @default(0) // ZenCreator 对标点数
  refLabel            String   @default("") // 对标说明，如 "ZC Wan 2.7 1080p/5s"
  priceMultiplierBps  Int      @default(13000) // 13000 = 130%，Spicy 默认 15000
  batchFourMultiplier Float    @default(1.5)
  unitSeconds         Int      @default(0) // 视频档位的计价基准秒数（0 = 非视频）
  requiresVip         Boolean  @default(false) // Spicy 档为 true
  defaultInputs       String? // JSON：固定注入上游的参数（分辨率、时长上限等）
  isActive            Boolean  @default(true)
  isDefault           Boolean  @default(false)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([mode, tier, spicy])
  @@index([mode, isActive, sortOrder])
  @@index([spicy, isActive])
}

/**
 * 模式 UI 参数 → 上游 input 字段映射
 */
model ModeParamMapping {
  id           Int      @id @default(autoincrement())
  mode         String
  uiKey        String // ratio | quality | duration | resolution …
  providerPath String   @map("zenPath") // 上游 input 的字段名；下划线开头为纯 UI 字段
  valueMap     String? // JSON object，空则原样传递
  options      String? // JSON array [{value,label}]
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([mode, uiKey])
  @@index([mode, enabled, sortOrder])
}

/**
 * 充值套餐：点数 ↔ 美分
 */
model CreditPackage {
  id         Int      @id @default(autoincrement())
  credits    Int
  priceCents Int
  label      String
  badge      String?
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([credits])
  @@index([isActive, sortOrder])
}

/**
 * VIP 等级：折扣率 discountBps（1000 = 10% off）
 */
model VipTier {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  name            String
  rank            Int      @default(0)
  discountBps     Int      @default(0)
  playthingAccess Boolean  @default(false) // 该等级 VIP 可进玩物专区
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plans VipPlan[]
  users User[]
}

/**
 * VIP 可售套餐：绑定等级 + 月费 + 赠点
 */
model VipPlan {
  id           Int      @id @default(autoincrement())
  tierId       Int
  label        String
  priceCents   Int
  bonusCredits Int      @default(0)
  durationDays Int      @default(30)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tier VipTier @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@index([isActive, sortOrder])
}

model Transaction {
  id                 Int      @id @default(autoincrement())
  userId             Int
  type               String
  amount             Int
  priceCents         Int?
  stripePaymentId    String?
  method             String?
  stripeAccountRefId Int? // 创建 Checkout 时使用的 StripeAccount.id
  createdAt          DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id])
  stripeAccount StripeAccount? @relation(fields: [stripeAccountRefId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

/**
 * 管理端操作审计：人工入账、VIP、余额、角色、封禁等
 */
model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int
  action     String // crypto_manual_credit | user_vip | user_balance | user_role | user_disable | mod_grant | mod_toggle
  targetType String?
  targetId   String?
  detail     String? // JSON
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

/**
 * 支付 Webhook 事件日志：Stripe / NOWPayments
 */
model WebhookEventLog {
  id         Int      @id @default(autoincrement())
  provider   String // stripe | nowpayments
  eventType  String?
  externalId String?
  status     String // ok | ignored | error
  detail     String?
  createdAt  DateTime @default(now())

  @@index([provider, createdAt])
}

/**
 * 上游生成渠道的 API Key：每个渠道同一时间最多一个 isActive=true。
 * 物理表名保持 WaveSpeedAccount 不变（下同）：库里已有生产数据，
 * 改表名要停机搬数据，而 @@map 是纯代码层改名，零 DDL。
 */
model ProviderAccount {
  id        Int      @id @default(autoincrement())
  provider  String   @default("wavespeed") // wavespeed | atlas
  label     String
  apiKeyEnc String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generations     PlaythingGeneration[]
  mainGenerations Generation[]

  @@index([provider, isActive])
  @@map("WaveSpeedAccount")
}

/**
 * 上游全库模型缓存（各渠道的模型列表接口同步而来）。
 * modelId 只在渠道内唯一：不同渠道可能上架同名模型（如 alibaba/wan-2.7/…）。
 */
model ProviderCatalogModel {
  id               Int      @id @default(autoincrement())
  provider         String   @default("wavespeed")
  modelId          String
  name             String
  type             String   @default("")
  description      String   @default("")
  basePriceUsd     Float    @default(0)
  lastUnitPriceUsd Float?
  thumbnailUrl     String?
  /**
   * 管理端手工贴的类型标签（JSON 字符串数组）。与同步下来的 type 分开存，同步不会覆盖。
   */
  tags             String   @default("[]")
  apiSchema        String? // JSON
  /// 上游 schema 文件地址（Atlas 是独立 JSON 文件）；未变化时同步可跳过重复抓取
  schemaUrl        String?
  syncedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product PlaythingProduct?

  @@unique([provider, modelId])
  @@index([provider, type])
  @@index([name])
  @@map("WaveSpeedCatalogModel")
}

/**
 * 玩物专区上架 SKU（本站定价，不吃 VIP 折扣）
 */
model PlaythingProduct {
  id                  Int      @id @default(autoincrement())
  provider            String   @default("wavespeed")
  modelId             String
  catalogModelId      Int?     @unique
  label               String
  creditCost          Int
  isActive            Boolean  @default(true)
  isRecommended       Boolean  @default(false)
  sortOrder           Int      @default(100)
  paramSchemaOverride String?
  paramPolicy         String? // JSON：时长档位、媒体 MIME/尺寸约束等
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  catalogModel ProviderCatalogModel? @relation(fields: [catalogModelId], references: [id], onDelete: SetNull)
  generations  PlaythingGeneration[]

  @@unique([provider, modelId])
  @@index([provider, isActive, isRecommended, sortOrder])
  @@map("WaveSpeedProduct")
}

/**
 * 玩物专区生成任务。
 * provider 冗余存一份：产品事后换绑渠道时，历史任务仍要能指认当初走的是谁。
 */
model PlaythingGeneration {
  id                 Int       @id @default(autoincrement())
  userId             Int
  productId          Int
  provider           String    @default("wavespeed")
  prompt             String    @default("")
  params             String    @default("{}")
  externalId         String?
  wsAccountId        Int?
  status             String    @default("pending") // pending|processing|succeeded|failed
  progress           Int       @default(0)
  error              String?
  resultUrls         String?
  cost               Int
  isAdult            Boolean   @default(false)
  safetyCategories   String    @default("[]")
  ownerVipAtCreation Boolean   @default(false)
  retentionAssigned  Boolean   @default(false)
  mediaExpiresAt     DateTime?
  mediaDeletedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user      User             @relation(fields: [userId], references: [id])
  product   PlaythingProduct @relation(fields: [productId], references: [id])
  wsAccount ProviderAccount? @relation(fields: [wsAccountId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([externalId])
  @@index([status, createdAt])
  @@index([mediaExpiresAt, mediaDeletedAt])
  @@map("WaveSpeedGeneration")
}

/// 草稿：尚未生成的编辑状态。
///
/// 刻意与 Generation 分表，而不是给它加一个 status="draft"：
/// Generation 被二十来处查询读取（/api/generations、/explore 公开画廊、
/// 管理端统计、媒体清理与保留、成本核算），加一个状态意味着每一处都要补
/// 排除条件，漏掉任何一处的后果是草稿泄漏进公开画廊，或者被媒体清理任务
/// 当成过期作品、把用户正在编辑的上传件删掉。分表让这些事故structurally
/// 不可能发生，而不是依赖「记得加过滤」。
model Draft {
  id     Int     @id @default(autoincrement())
  userId Int
  mode   String
  tier   String  @default("low")
  spicy  Boolean @default(false)

  /// 编辑时命中的档位与上游模型，用于事后判定兼容性（模型可能已被换掉）
  productId       Int?
  providerModelId String?

  /// 用户可命名；空则列表里取 prompt 前若干字
  title          String?
  prompt         String  @default("")
  negativePrompt String?

  /// 表单快照 JSON，编解码见 lib/draft-snapshot.ts，将来与模板共用
  snapshot String @default("{}")

  /// 点击生成后挂上的任务单。非空即「已提交、等着确认能不能删」，
  /// 打开草稿页时据此对账（防止收尾没删干净）
  generationId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, mode, updatedAt])
  @@index([generationId])
}

/// 模板：命名保存、可重复套用。
///
/// 与 Draft 分表而不是加一个 isTemplate 标志位：草稿有「生成成功即自动删除」
/// 的规则，共表就等于把「记得跳过模板」放进删除逻辑里，踩雷的代价是用户
/// 攒了几个月的模板一次性消失。两张表共用同一套快照编解码。
model PromptTemplate {
  id     Int     @id @default(autoincrement())
  userId Int
  mode   String
  tier   String?
  spicy  Boolean @default(false)

  /// 存下来时命中的档位与上游模型，仅作留痕；兼容性一律按当前 specs 现算
  productId       Int?
  providerModelId String?

  name           String
  prompt         String  @default("")
  negativePrompt String?
  snapshot       String  @default("{}")

  /// 来源留痕：从哪条草稿或哪件作品存下来的
  sourceDraftId      Int?
  sourceGenerationId Int?
  useCount           Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, mode, updatedAt])
  @@index([userId, updatedAt])
}

/// 各家模型的媒体引用语法。
///
/// 提示词里存的是规范形式（@Image1 / @Video1 / @Audio1），提交上游前按目标
/// 模型改写。两家已确认的写法差得很远：
///   Seedance   @image1     （schema 原话：Cite reference inputs with @-syntax）
///   Wan 2.7    character1  （不带 @，语义是把参考素材映射到角色）
/// 所以不能写死在代码里，也不能靠猜——做成表，管理端可编辑，接新模型时补一行。
///
/// 匹配不到任何一行时**原样透传**，等于接入前的行为，不会造成回归。
model ModelRefSyntax {
  id           Int     @id @default(autoincrement())
  label        String
  /// 与上游 modelId 做不区分大小写的子串匹配；留空表示兜底（匹配一切）
  matchModelId String  @default("")
  /// 限定渠道（wavespeed / atlas…），留空则不限
  provider     String?

  /// 写法模板，{n} 是该类型内的序号（从 1 开始）。
  /// 留空表示「把这个引用整个删掉」——有些模型只认数组顺序，
  /// 提示词里出现它不认识的记号反而会被当成正文读进去。
  imageFormat String @default("@image{n}")
  videoFormat String @default("@video{n}")
  audioFormat String @default("@audio{n}")

  enabled   Boolean  @default(true)
  /// 越小越先匹配；兜底行放大值
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, sortOrder])
}
