# ===== AVClubs Web (Next.js) =====

# PostgreSQL 连接串（本地默认：Homebrew 安装的 postgresql@17，当前系统用户免密）
# 本地初始化：
#   brew install postgresql@17 && brew services start postgresql@17
#   /opt/homebrew/opt/postgresql@17/bin/createdb avclubs
# 生产示例：postgresql://user:pass@host:5432/avclubs?sslmode=require
DATABASE_URL="postgresql://localhost:5432/avclubs"

# 会话签名密钥，必须 >= 32 字符。生成方式：
#   openssl rand -hex 32
AUTH_SECRET=""

# 应用公网地址：Stripe 回跳 + OAuth redirect_uri 都由它拼出。
# 必须与用户实际访问的域名完全一致（含 https、无尾斜杠），
# 否则 Google/Facebook 会因 redirect_uri 不匹配而拒绝登录。
APP_URL="http://localhost:3000"

# Google Search Console「HTML 标记」验证的 content 值
# 示例标签 <meta name="google-site-verification" content="abc123"> 这里只填 abc123
GOOGLE_SITE_VERIFICATION=""

# 第三方登录
# Google Cloud Console Web application redirect URI:
#   {APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Meta for Developers Facebook Login redirect URI:
#   {APP_URL}/api/auth/oauth/facebook/callback
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_GRAPH_VERSION="v25.0"

# 注册邮箱验证（Resend）。EMAIL_FROM 必须使用已在 Resend 验证的域名。
RESEND_API_KEY=""
EMAIL_FROM="玩玩可物 <no-reply@example.com>"

# 注册所在地（可选）。不配置时仍会读取 Cloudflare/Vercel 等平台提供的 Geo headers。
# Lite Token 可提供国家；Core/Plus 可进一步提供地区与城市。
IPINFO_TOKEN=""
IPINFO_API_BASE="https://api.ipinfo.io"

# Cloudflare Turnstile（登录/注册人机验证）
# Site key 是公开的，须与 Cloudflare 仪表盘里该 widget 一致；Secret 仅后端使用：
TURNSTILE_SITE_KEY="0x4AAAAAAD8ko6Wpne6AI8m0"
TURNSTILE_SECRET=""

# Stripe（可选兜底；推荐在管理端 /admin/stripe 配置多账户）
# DEMO_MODE=false 时才会走真实 Checkout
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# NOWPayments ENV 兜底（推荐在 /admin/nowpayments 加密保存并激活数据库配置）
# 只有管理端没有激活配置时，创建订单才读取下列变量。
# API Key 与 IPN Secret 都在 Store Settings 创建；IPN Secret 只显示一次，请妥善保存。
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
NOWPAYMENTS_BASE_URL="https://api.nowpayments.io/v1"

# 点数套餐（美分）
# 单点美元价与 ZenCreator Starter 对齐并细分 10 倍（$19.99/2000 = $0.009995/点），
# 细分是为了让整数扣点能精确表达生成端的 130% / 150% 倍率
CREDIT_PACKAGES='{"2000": 1999, "5500": 4999, "12000": 9900, "63000": 49900}'

# VIP 月费（美分）
VIP_PRICE=9900

# Telegram 通知（选填）：充值成功、新用户注册、生成失败退款、上游成本预算告警
# Bot Token 从 @BotFather 获取；Chat ID 为接收通知的用户/群组 ID
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# WaveSpeed 月度成本预算（美元），0 表示不设预算不告警；达 80% 会推 Telegram
WAVESPEED_MONTHLY_BUDGET_USD=0

# 魔法指令（选填）：Hugging Face Dolphin-Mistral-24B-Venice-Edition
# 推荐在管理端 /admin/hf 配置多 Token；无激活 DB 账户时回退此处
# Token: https://huggingface.co/settings/tokens （需 Inference Providers 权限）
# 模型页: https://huggingface.co/dphn/Dolphin-Mistral-24B-Venice-Edition
# 未配置时创作页不显示「魔法指令」按钮
HF_TOKEN=""
# HF_INFERENCE_BASE_URL="https://router.huggingface.co/v1"
# HF_MAGIC_MODEL="dphn/Dolphin-Mistral-24B-Venice-Edition:featherless-ai"

# 内容审查（强烈建议配置）：OpenAI Moderation
# omni-moderation-latest 是免费的专用分类器，~100ms，自带 sexual/minors 独立类别，
# 比用 24B 通用 LLM 做分类更快更稳。留空则自动降级到 HF LLM。
# 审查链路：本地正则 → OpenAI → HF，任一级出结论即返回，全部不可用才报错。
# 「非自愿性行为」类别 OpenAI 没有对应项，只由本地正则覆盖。
# Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODERATION_MODEL="omni-moderation-latest"

# 生成端与玩物专区共用的唯一上游：WaveSpeed.ai
# 推荐在管理端 /admin/wavespeed 配置多账户；无激活 DB 账户时回退此处
# 配置后需到「模型库」同步一次目录，档位才能绑定模型
# https://wavespeed.ai/accesskey
WAVESPEED_API_KEY=""
# WAVESPEED_BASE_URL="https://api.wavespeed.ai/api/v3"

# 演示模式：true 时充值直接到账、生成用占位图、自动创建 demo 账号
# （demo_user/demo123 普通用户；mod_user/mod123 审核员；admin_user/admin123 管理员）
# 生产环境必须设为 false（否则进程拒绝启动）
DEMO_MODE=false

# 对象存储 OSS（S3 兼容：阿里云 OSS / AWS S3 / MinIO / Cloudflare R2）
# 推荐在管理端 /admin/oss 配置多账户；无激活 DB 账户时回退此处
# 阿里云示例：
#   OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
#   OSS_REGION=oss-cn-hangzhou
#   OSS_BUCKET=your-bucket
#   OSS_PUBLIC_BASE_URL=https://cdn.yourdomain.com
OSS_ENDPOINT=""
OSS_REGION="us-east-1"
OSS_BUCKET=""
OSS_ACCESS_KEY_ID=""
OSS_SECRET_ACCESS_KEY=""
OSS_PUBLIC_BASE_URL=""
OSS_PATH_PREFIX="media"
OSS_MIRROR_RESULTS=true
OSS_FORCE_PATH_STYLE=false

# 自动媒体清理：使用 openssl rand -hex 32 生成，与 Railway Cron 服务保持一致
MEDIA_CLEANUP_SECRET=""
# 每次每类最多处理 1–500 条；定时任务会在后续轮次继续处理积压
MEDIA_CLEANUP_BATCH_SIZE=100

# 管理员种子账号（选填，生产可用）：首次登录该用户名时自动创建/提升为 admin
# 密码至少 8 位
SEED_ADMIN_USERNAME=""
SEED_ADMIN_PASSWORD=""
